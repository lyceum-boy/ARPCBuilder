      m_Calls: []
  m_text: "1. \u0423\u043A\u0430\u0436\u0438 \u0433\u0440\u0430\u043D\u0438\u0446\u044B \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.\r\n\r\n2. \u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430.\r\n\r\n3. \u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.\r\n\r\n4. \u0418\u0437\u0443\u0447\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0449\u0438\u0435 \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u0438\u0445 \u0432 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430.\r\n\r\n5. \u0417\u0430\u0432\u0435\u0440\u0448\u0438 \u0441\u0431\u043E\u0440\u043A\u0443, \u0441\u043B\u0435\u0434\u0443\u044F \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430\u043C \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F."
